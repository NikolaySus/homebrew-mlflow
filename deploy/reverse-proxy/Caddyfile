http://git.localhost:8080 {
  reverse_proxy gitlab:80
}

http://secrets.localhost:8080 {
  reverse_proxy infisical:8080
}

http://ops.localhost:8080 {
  reverse_proxy grafana:3000
}

http://localhost:8080, http://127.0.0.1:8080 {
  handle /api/* {
    reverse_proxy api:8000
  }
  handle /health/* {
    reverse_proxy api:8000
  }
  handle /openapi.json {
    reverse_proxy api:8000
  }
  handle /docs {
    reverse_proxy api:8000
  }
  handle_path /mlflow/* {
    forward_auth api:8000 {
      uri /api/v1/auth/mlflow/authorize
      header_up Cookie {http.request.header.Cookie}
      copy_headers Authorization X-MLflow-Workspace
    }
    reverse_proxy mlflow:5000 {
      header_up -Cookie
    }
  }
  handle_path /packages/* {
    root * /srv/packages
    @immutable path /files/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @index path /simple/* /release-manifest.json
    header @index Cache-Control "no-cache"
    file_server
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
